+class ThreadStopException(Exception):
+    """
+    Raised to intentionally terminate a control thread.
+
+    It used to be faked with a NameError, which every thread caught with
+    `except (NameError, KeyboardInterrupt)`.  A dedicated exception makes the
+    intent explicit and lets the actuator threads re-raise it instead of
+    swallowing it as a recoverable error.
+    """
+    pass
+
+
+def safe_input(prompt, default='n'):
+    """
+    Read a confirmation from stdin without crashing when there is no terminal.
+
+    The control threads are often started from a script or a pipe, in which
+    case `input()` raises EOFError.  That EOFError used to be caught by the
+    generic `except Exception` handler of the thread and reported as a
+    control error (state 2.0), which poisoned the whole stack through
+    `thread_error()`.  Treat EOF as "no" and let the caller exit cleanly.
+    """
+    try:
+        return input(prompt)
+    except EOFError:
+        print('\n[no terminal on stdin] assuming "%s"' % default)
+        return default
+
