+class TimedBEAR(Manager.BEAR):
+    """Bound single-response reads without weakening checksum or motor-ID checks."""
+    def _PKT__read_packet(self, motor_id):
+        timeout = self._timeout if self._timeout is not None else 0.005
+        deadline = time.monotonic() + timeout
+        buffer = bytearray()
+        while time.monotonic() < deadline:
+            available = self.ser.in_waiting
+            if available:
+                buffer.extend(self.ser.read(available))
+            while len(buffer) >= 4:
+                if buffer[0] != 0xFF or buffer[1] != 0xFF:
+                    del buffer[0]
+                    continue
+                if buffer[2] != motor_id or not 2 <= buffer[3] <= 253:
+                    del buffer[0]
+                    continue
+                length = 4 + buffer[3]
+                if len(buffer) < length:
+                    break
+                packet = buffer[:length]
+                if ((~sum(packet[2:-1])) & 0xFF) == packet[-1]:
+                    return list(packet[5:-1]), packet[4]
+                del buffer[0]
+            if not available:
+                time.sleep(0)
+        return None, None
+
